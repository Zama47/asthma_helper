root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120
# ktlint
ktlint_code_style = android_studio
# Compose-функции пишутся с заглавной буквы — не считаем это нарушением
ktlint_standard_function-naming = disabled

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{xml}]
indent_size = 4
